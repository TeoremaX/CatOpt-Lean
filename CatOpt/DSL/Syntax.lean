/-!
# Typed compositional syntax

`Program` is a syntax tree, not itself a strict category: syntactic trees do
not identify `(p >>> q) >>> r` with `p >>> (q >>> r)`. Its *semantics*
will satisfy the category laws. A quotient/free-path category is future work.
-/
namespace CatOpt.DSL

universe u v

/-- A signature gives primitive operation types between phases/objects. -/
structure Signature (Obj : Type u) where
  Edge : Obj → Obj → Type v

/-- Well-typed programs generated by primitive arrows and sequencing. -/
inductive Program {Obj : Type u} (σ : Signature.{u,v} Obj) : Obj → Obj → Type (max u v) where
  | skip {a : Obj} : Program σ a a
  | atom {a b : Obj} : σ.Edge a b → Program σ a b
  | seq {a b c : Obj} : Program σ a b → Program σ b c → Program σ a c

/-- Loop syntax generated by iterating a closed typed pipeline. -/
def Program.repeat {Obj : Type u} {σ : Signature.{u,v} Obj}
    {a : Obj} (p : Program σ a a) : Nat → Program σ a a
  | 0 => .skip
  | n + 1 => .seq p (Program.repeat p n)

end CatOpt.DSL
